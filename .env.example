# 复制为项目根目录的 .env，填写需要使用的服务；等号后不要加引号。
# 普通聊天：填入 DeepSeek 或其他 OpenAI 兼容服务的密钥。
SKINCARE_LLM_API_KEY=
# 以下普通聊天配置不填时使用项目默认值。
# SKINCARE_LLM_BASE_URL=https://api.deepseek.com
# SKINCARE_LLM_MODEL=deepseek-flash

# 痤疮照片分析：三个配置必须来自支持图片的同一服务。
SKINCARE_VISION_BASE_URL=
SKINCARE_VISION_MODEL=qwen3-vl-plus
SKINCARE_VISION_API_KEY=

# 联网产品搜索可选；不使用时留空。
SKINCARE_SEARCH_API_KEY=
